{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Shipping Options Response",
    "description": "Discoverable shipping methods for the current cart context",
    "type": "object",
    "required": [
        "currency",
        "options"
    ],
    "properties": {
        "currency": {
            "type": "string",
            "examples": [
                "USD"
            ]
        },
        "options": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "label",
                    "amount",
                    "estimatedDelivery"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "object",
                        "required": [
                            "amount",
                            "currency"
                        ],
                        "properties": {
                            "amount": {
                                "type": "number"
                            },
                            "currency": {
                                "type": "string"
                            }
                        }
                    },
                    "estimatedDelivery": {
                        "type": "object",
                        "required": [
                            "minDays",
                            "maxDays"
                        ],
                        "properties": {
                            "minDays": {
                                "type": "integer"
                            },
                            "maxDays": {
                                "type": "integer"
                            }
                        }
                    },
                    "freeOver": {
                        "type": "object",
                        "properties": {
                            "amount": {
                                "type": "number"
                            },
                            "currency": {
                                "type": "string"
                            }
                        }
                    },
                    "description": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
