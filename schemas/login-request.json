{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Login Request",
    "description": "Username and password credentials for JWT authentication",
    "type": "object",
    "required": [
        "username",
        "password"
    ],
    "properties": {
        "username": {
            "type": "string",
            "description": "Account username",
            "examples": [
                "demo"
            ]
        },
        "password": {
            "type": "string",
            "format": "password",
            "description": "Account password",
            "examples": [
                "demo123"
            ]
        }
    }
}
