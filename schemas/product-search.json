{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Product Search Request",
    "description": "Parameters for searching the product catalog",
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Search query text",
            "examples": [
                "wireless headphones"
            ]
        },
        "filters": {
            "type": "object",
            "description": "Typed catalog filters (additionalProperties remains open in 0.4.0)",
            "additionalProperties": true,
            "properties": {
                "brand": {
                    "type": "string",
                    "description": "Exact brand match (case-insensitive)",
                    "examples": [
                        "Acme"
                    ]
                },
                "categories": {
                    "type": "array",
                    "description": "Match products in any listed category",
                    "items": {
                        "type": "string"
                    },
                    "examples": [
                        [
                            "Headphones"
                        ]
                    ]
                },
                "priceRange": {
                    "type": "object",
                    "description": "Inclusive bounds on product price.amount",
                    "properties": {
                        "min": {
                            "type": "number"
                        },
                        "max": {
                            "type": "number"
                        },
                        "currency": {
                            "type": "string",
                            "default": "USD",
                            "examples": [
                                "USD"
                            ]
                        }
                    }
                },
                "availability": {
                    "type": "array",
                    "description": "Subset of product availability.status values",
                    "items": {
                        "type": "string",
                        "enum": [
                            "in_stock",
                            "low_stock",
                            "out_of_stock",
                            "backorder",
                            "preorder"
                        ]
                    }
                },
                "extensions": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "examples": [
                {
                    "brand": "Acme",
                    "categories": [
                        "Headphones"
                    ],
                    "priceRange": {
                        "min": 50,
                        "max": 200,
                        "currency": "USD"
                    },
                    "availability": [
                        "in_stock"
                    ]
                }
            ]
        },
        "sort": {
            "type": "string",
            "description": "Sorting method",
            "enum": [
                "price_asc",
                "price_desc",
                "name_asc",
                "name_desc",
                "relevance",
                "newest"
            ],
            "default": "relevance",
            "examples": [
                "price_asc"
            ]
        },
        "page": {
            "type": "integer",
            "description": "Page number (1-based)",
            "minimum": 1,
            "default": 1,
            "examples": [
                1
            ]
        },
        "pageSize": {
            "type": "integer",
            "description": "Number of items per page",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "examples": [
                10
            ]
        },
        "extensions": {
            "type": "object",
            "description": "Additional custom fields",
            "additionalProperties": true
        }
    }
}