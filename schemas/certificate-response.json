{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Certificate Response",
    "description": "Certificate verification session",
    "type": "object",
    "required": [
        "session_id",
        "expires_in"
    ],
    "properties": {
        "session_id": {
            "type": "string",
            "description": "Certificate session identifier",
            "examples": [
                "cert-sess-a1b2c3d4"
            ]
        },
        "expires_in": {
            "type": "integer",
            "description": "Session lifetime in seconds",
            "examples": [
                3600
            ]
        }
    }
}
