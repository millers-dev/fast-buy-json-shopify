# One process, one shop. Copy to .env and export it, or start with:
# node --env-file=.env dist/src/index.js
# .env is gitignored. Do not commit tokens or the client secret.

PORT=3100
SHOPIFY_SHOP=example.myshopify.com

# Dev Dashboard app, custom distribution. Required together to store a token.
# Leave all three unset to serve GET /detect only.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 32 bytes, base64. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Pinned Admin and Storefront API version.
SHOPIFY_API_VERSION=2026-10

# Order address gate. Off unless the trimmed value is 1 or true (any case).
# Off ignores ?email= and omits shippingAddress and billingAddress.
# On returns those addresses only when ?email= matches the order email.
# SHOPIFY_ORDER_ADDRESS_GATE=

# Customer Account API login. Off unless the trimmed value is 1 or true (any case).
# Off keeps anonymous orders and does not advertise auth on /detect.
# On requires the FastBuyJSON JWT on GET /orders/{orderId} and proves ownership
# before the Admin order read. Addresses stay off. /detect still does not list jwt.
# SHOPIFY_CUSTOMER_ACCOUNTS=

# HMAC key for the JWT sub. UTF-8, at least 32 bytes, from a CSPRNG.
# Unset: the process starts, and login completion returns 500.
# Shorter than 32 bytes: the process refuses to start.
# SHOPIFY_CUSTOMER_SUB_SECRET=

# Signs the FastBuyJSON JWT (sub, iat, exp). Unset: login completion returns 500.
# While SHOPIFY_CUSTOMER_ACCOUNTS is on, an order read also returns 500 if this is unset.
# JWT_SECRET=

# Trusted proxy hops for POST /auth/customer/start. Unset or empty is 0
# (the TCP socket address; X-Forwarded-For is not read).
# A set value must be an integer from 0 through 10 after trim, or the process
# refuses to start. 1abc is rejected. It is not parsed as 1 and does not fall back to 0.
# SHOPIFY_TRUSTED_PROXY_HOPS=

# HTTPS origin for the OAuth callback. Leave unset for the client-credentials
# grant (Dev Dashboard app and development store in the same organization).
# APP_URL=https://your-tunnel.example.com
